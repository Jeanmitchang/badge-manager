# ─── Badge Manager v2 — Configuration ─────────────────────
# Copier ce fichier vers .env et adapter les valeurs.
# cp .env.example .env

# ─── JWT ───────────────────────────────────────────────────
# Secret pour signer les tokens JWT (OBLIGATOIRE en production).
# Générer un secret fort : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si absent ou faible, un secret temporaire est généré au démarrage (non persistant).
VIGIK_JWT_SECRET=

# ─── Réseau ───────────────────────────────────────────────
VIGIK_HOST=0.0.0.0
VIGIK_PORT=8766

# ─── CORS (optionnel) ─────────────────────────────────────
# Liste d'origins autorisées séparées par des virgules.
# Laisser vide = pas de CORS (frontend servi par le même serveur).
# Exemple : https://mon-domaine.com,https://autre.domaine.com
VIGIK_CORS_ORIGINS=

# ─── SSL/TLS (optionnel) ──────────────────────────────────
# Chemins vers le certificat et la clé privée.
# Si vides, le serveur démarre en HTTP.
VIGIK_SSL_CERT=
VIGIK_SSL_KEY=

# ─── Vigik / Wine ─────────────────────────────────────────
# Chemin vers l'exécutable Windows et le certificat Vigik.
VIGIK_EXE=./vigik_loader_cli.exe
VIGIK_CERT=./cert.txt

# ─── Stockage ─────────────────────────────────────────────
# Répertoire de sortie des fichiers MCT générés.
VIGIK_MCT=./mct_output

# Chemin vers la base de données SQLite.
# Par défaut : ./data/badge_manager.db (relatif au répertoire du projet).
VIGIK_DB_PATH=./data/badge_manager.db
