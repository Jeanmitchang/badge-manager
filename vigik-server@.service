[Unit]
Description=VIGIK Badge Manager Server
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/Documents/Vigik
EnvironmentFile=/home/%i/Documents/Vigik/.env
ExecStart=/home/%i/Documents/Vigik/venv/bin/python3 /home/%i/Documents/Vigik/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
