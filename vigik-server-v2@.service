[Unit]
Description=Badge Manager v2 Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=%i
# Adapter WorkingDirectory au chemin d'installation réel
# Exemples : /opt/badge-manager, /home/%i/badge-manager, /srv/vigik
WorkingDirectory=/opt/badge-manager
EnvironmentFile=/opt/badge-manager/.env
ExecStart=/opt/badge-manager/venv/bin/python3 /opt/badge-manager/server_v2.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=badge-manager-v2

# Sécurité systemd
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/badge-manager/data /opt/badge-manager/mct_output /opt/badge-manager/backups
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
